# Copy to .env and adjust. Every setting from app/core/config.py is listed here.

# Shown in the OpenAPI docs.
APP_NAME=Geospatial File Measurement API
# dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
# false = human-readable logs for local development
LOG_JSON=true
# SQLite for local runs; Postgres in production:
# postgresql+asyncpg://geo:geo@localhost:5432/geo   (MySQL: mysql+asyncmy://..., see README)
DATABASE_URL=sqlite+aiosqlite:///./data/geo.db
# true = create tables on startup (dev). In production set false and run `alembic upgrade head`.
AUTO_CREATE_TABLES=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=30000
# Where uploads live. Must be shared between API and workers.
STORAGE_DIR=data/storage
# inline = process inside the upload request (no Redis needed)
# worker = queue on Redis, processed by `arq app.workers.settings.WorkerSettings`
PROCESSING_MODE=inline
REDIS_URL=redis://localhost:6379/0
WORKER_MAX_JOBS=2
# Hard deadline per file; the file is marked FAILED when exceeded.
JOB_TIMEOUT_S=900
# Attempts for *transient* errors (exponential backoff). Corrupt files are never retried.
JOB_MAX_TRIES=3
JOB_RETRY_BASE_DELAY_S=5
# Hard cap on the request body, counted as bytes arrive (not from Content-Length).
MAX_UPLOAD_BYTES=104857600
# KML must be fully parsed (no random access), so it gets a tighter cap.
MAX_KML_BYTES=52428800
UPLOAD_CHUNK_BYTES=1048576
MAX_ZIP_ENTRIES=100
MAX_ZIP_UNCOMPRESSED_BYTES=1073741824
# Zip-bomb guard: reject entries expanding more than N:1.
MAX_ZIP_COMPRESSION_RATIO=100
ZIP_RATIO_MIN_BYTES=1048576
# true = reject shapefiles without a readable CRS. false = assume ASSUMED_CRS and add a CRS_ASSUMED warning.
REQUIRE_PRJ=true
ASSUMED_CRS=EPSG:4326
# Per-file budgets, enforced before/while reading.
MAX_FEATURES=1000000
MAX_VERTICES=10000000
# Features per read/measure/insert batch (bounds memory).
READ_BATCH_SIZE=5000
# Features wider than this get a LARGE_EXTENT warning (UTM distortion grows with extent).
LONG_EXTENT_DEGREES=3.0
PAGE_DEFAULT_LIMIT=100
PAGE_MAX_LIMIT=1000
# Lower cap when geometries are included in a page.
PAGE_MAX_LIMIT_WITH_GEOMETRY=100
# Byte budget (summed WKB size) for geometries in one page.
PAGE_MAX_GEOMETRY_BYTES=2097152
# Backpressure: global PENDING+PROCESSING cap (503 + Retry-After beyond it).
MAX_INFLIGHT_JOBS=100
# Backpressure: per client IP (429 + Retry-After beyond it).
MAX_ACTIVE_FILES_PER_CLIENT=5
# Inline mode only; in worker mode the sweeper is an arq cron job.
RUN_SWEEPER_IN_API=true
SWEEP_INTERVAL_S=300
STALE_TMP_AGE_S=3600
STALE_PENDING_S=3600
STALE_PROCESSING_S=2100
# How long a DELETING file may linger before the sweeper purges it.
DELETE_GRACE_S=300
# FAILED files (and their blobs) are purged after this long.
FAILED_RETENTION_S=604800
ORPHAN_BLOB_GRACE_S=3600
